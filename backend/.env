# LearnPilot AI — Backend Environment Variables
# Generated from .env.example

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=learnpilot-dev-secret-change-in-production-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./learnpilot.db

# ── Google Gemini AI ─────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── YouTube Data API (optional) ──────────────────────────────
YOUTUBE_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── File Upload ──────────────────────────────────────────────
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
